{
	"name": "areas.me",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"scripts": {
		"dev": "next dev -p 3000",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"reinstall": "rm -rf node_modules .next package-lock.json && npm i",
		"update:latest": "npx -y npm-check-updates -u && npm i && npm dedupe && npm outdated && npm ls",
		"rollback:eslint": "npm i -D eslint@^9",
		"biome:check": "npx biome check",
		"biome:check:write": "npx biome check --write",
		"biome:check:write:unsafe": "npx biome check --write --unsafe",
		"vercel:env:pull": "vercel env pull .env.local",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx src/lib/db/seed/seed.ts",
		"db:token:create": "tsx src/lib/db/tokens/create.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@neondatabase/serverless": "^1.1.0",
		"drizzle-orm": "^0.45.2",
		"next": "^16.2.12",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.0",
		"eslint-config-next": "^16.2.12",
		"playwright-chromium": "^1.62.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
